#
# Environment used to build and run HPCW on MN5. The module list mirrors the model
# environment (toolchains/mareNostrum5/bsc-intel.env.sh); the deviations required by the
# Automatic Performance Profiling are marked with [APP].

module purge
module load bsc
module load git/2.45.0
module load intel/2023.2
module load openmpi/4.1.5
module load mkl/2023.2 # always load the same version number as intel
module load extrae

module load hdf5/1.14.1-2-openmpi
# Not using the system NetCDF
#module load pnetcdf/1.12.3-openmpi
#module load netcdf/c-4.9.2_fortran-4.6.1_cxx4-4.3.1_hdf5-1.14.1-2_pnetcdf-1.12.3-openmpi
module load python/3.9.16
module load perl/5.38.2
module load fftw/3.3.10-openmpi
module load cmake/3.25.1

module load binutils/2.37

# [APP] The model environment leaves SZIP out, but the HDF5 libraries of the modules need
# libsz.so.2 when the model runs
module load szip/2.1.1

# Compile exports

# use CDO installed on mn5
PATH=/gpfs/apps/MN5/GPP/SPACK/0.21.2/opt/spack/linux-rhel9-sapphirerapids/gcc-11.3.1/cdo-2.2.2-z2umj3hwc3i46jivnq5qhlyxqyjn36wu/bin:$PATH

# [APP] Build with the MPI compiler wrappers so that the netcdf-fortran built by the model
# uses the same Fortran MPI bindings. With the serial compilers CMake selects the mpi_f08
# handles for netcdf-fortran and the model aborts with MPI_ERR_INFO in MPI_File_open
export CC=mpicc
export CXX=mpicxx
export FC=mpif90
# [APP] FCFLAGS is the only place where the model takes its compilation flags from (it
# ignores CMAKE_Fortran_FLAGS), so the optimization level has to be here. Only the ISA
# flag, the optimization/debug flags and the tracing flags are set: the rest of the
# <ARCH>.cmake preset (-i4 -r8 -align array64byte -fp-model precise -fno-alias) applies to
# the CMake built components and breaks the model (-r8 gives REAL4/REAL8 the same kind,
# which makes the REAL2STRING generic interface ambiguous). ifort does not accept
# -march=sapphirerapids as default processor for vector functions (error #13400)
export CFLAGS="-xCORE-AVX512 -qopt-zmm-usage=high"
export FCFLAGS="-xCORE-AVX512 -qopt-zmm-usage=high -g -traceback -O3 -finstrument-functions -rdynamic"

module list
cmake --version

# default packages
cmakeFlags="${cmakeFlags:- }"
cmakeFlags+=" -DENABLE_mpi=ON"
#cmakeFlags+=" -DSZIP_ROOT_DIR=/apps/GPP/SZIP/2.1.1/INTEL/"
cmakeFlags+=" -DCMAKE_TOOLCHAIN_FILE=$HPCW_SOURCE_DIR/toolchains/mareNostrum5/bsc-intel-mpi.cmake"
cmakeFlags+=" -DENABLE_SVN_CHECKOUT=ON"
cmakeFlags+=" -DBUILD_PARALLEL_LEVEL=${BUILD_PARALLEL_LEVEL-8}"

# Runtime exports

if [ -n "${HPCW_INSTALL:-}" ]; then
    export LD_LIBRARY_PATH=${HPCW_INSTALL}/lib:${LD_LIBRARY_PATH:-}
fi

export OMP_NUM_THREADS=1
export KMP_AFFINITY=${KMP_AFFINITY:-"granularity=fine,scatter"}
ulimit -s 2097152
ulimit -c 0   

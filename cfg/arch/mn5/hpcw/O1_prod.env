module purge
module load bsc
module load git/2.45.0
module load intel/2023.2
module load openmpi/4.1.5
module load mkl/2023.2 # always load the same version number as intel

module load hdf5/1.14.1-2-openmpi
#Not using the system NetCDF because it breaks with icon
#module load pnetcdf/1.12.3-openmpi
#module load netcdf/c-4.9.2_fortran-4.6.1_cxx4-4.3.1_hdf5-1.14.1-2_pnetcdf-1.12.3-openmpi
module load python/3.9.16
module load perl/5.38.2
module load fftw/3.3.10-openmpi
module load cmake/3.25.1

module load binutils/2.37

#module load szip/2.1.1

# Compile exports

# use CDO installed on mn5
PATH=/gpfs/apps/MN5/GPP/SPACK/0.21.2/opt/spack/linux-rhel9-sapphirerapids/gcc-11.3.1/cdo-2.2.2-z2umj3hwc3i46jivnq5qhlyxqyjn36wu/bin:$PATH

export CC=icc
export CXX=icpc
export FC=ifort
export CFLAGS="-march=sapphirerapids"
export FCFLAGS="-march=sapphirerapids"
export ICON_FCFLAGS="-DDO_NOT_COMBINE_PUT_AND_NOCHECK"

module list
cmake --version

# default packages
cmakeFlags="${cmakeFlags:- }"
cmakeFlags+=" -DENABLE_mpi=ON"
#cmakeFlags+=" -DSZIP_ROOT_DIR=/apps/GPP/SZIP/2.1.1/INTEL/"
cmakeFlags+=" -DCMAKE_TOOLCHAIN_FILE=$HPCW_SOURCE_DIR/toolchains/mareNostrum5/bsc-intel-mpi.cmake"
cmakeFlags+=" -DENABLE_SVN_CHECKOUT=ON"
cmakeFlags+=" -DBUILD_PARALLEL_LEVEL=${BUILD_PARALLEL_LEVEL-8}"

# Runtime exports

export LD_LIBRARY_PATH=${HPCW_INSTALL}/lib:$LD_LIBRARY_PATH

export OMP_NUM_THREADS=1
export ICON_THREADS=${OMP_NUM_THREADS}
export KMP_AFFINITY=${KMP_AFFINITY:-"granularity=fine,scatter"}
ulimit -s 2097152
ulimit -c 0   

module purge
module load git/2.45.0
module load intel/2025.2
module load impi/2021.13
module load mkl/2025.2 # always load the same version number as intel
module load extrae/4.3.3

module load hdf5/1.14.1-2
module load pnetcdf/1.12.3
module load netcdf/c-4.9.2_fortran-4.6.1_cxx4-4.3.1_hdf5-1.14.1-2_pnetcdf-1.12.3
module load python/3.9.16
module load perl/5.38.2
module load cmake/3.30.5

module load binutils/2.37
module load cdo
module load szip/2.1.1

# Compile exports

export CC=mpicc
export CXX=mpicxx
export FC=mpif90
export CFLAGS="-O2 -march=core-avx2 -g"
export FCFLAGS="-O2 -march=core-avx2 -g -traceback -O3 -finstrument-functions -rdynamic"
export ICON_FCFLAGS="-DDO_NOT_COMBINE_PUT_AND_NOCHECK"

module list
cmake --version

# default packages
cmakeFlags="${cmakeFlags:- }"
cmakeFlags+=" -DENABLE_mpi=ON"
#cmakeFlags+=" -DSZIP_ROOT_DIR=/apps/GPP/SZIP/2.1.1/INTEL/"
cmakeFlags+=" -DCMAKE_TOOLCHAIN_FILE=$HPCW_SOURCE_DIR/toolchains/mareNostrum5/bsc-intel-mpi.cmake"
cmakeFlags+=" -DENABLE_SVN_CHECKOUT=ON"
cmakeFlags+=" -DBUILD_PARALLEL_LEVEL=${BUILD_PARALLEL_LEVEL-8}"

# Runtime exports

if [ -n "${HPCW_INSTALL:-}" ]; then
    export LD_LIBRARY_PATH=${HPCW_INSTALL}/lib:${LD_LIBRARY_PATH:-}
fi

export OMP_NUM_THREADS=1
export ICON_THREADS=${OMP_NUM_THREADS}
export OMP_SCHEDULE=dynamic,1
export OMP_DYNAMIC="false"
export OMP_STACKSIZE=200M
export MALLOC_TRIM_THRESHOLD_="-1"
export KMP_AFFINITY=${KMP_AFFINITY:-"granularity=fine,scatter"}
export KMP_LIBRARY="turnaround"
export MKL_DEBUG_CPU_TYPE="5"
export MKL_ENABLE_INSTRUCTIONS="AVX2"
export HDF5_USE_FILE_LOCKING=FALSE
export HDF5_DISABLE_VERSION_CHECK=2
export HDF5_COLL_METADATA_READ=FALSE
export I_MPI_EXTRA_FILESYSTEM=on
export I_MPI_EXTRA_FILESYSTEM_LIST=gpfs
export ROMIO_FSTYPE_FORCE="*gpfs"
export MPICH_MPIIO_HINTS="*:romio_cb_read=disable:romio_ds_read=disable:cb_nodes=8:cb_buffer_size=33554432"
ulimit -s unlimited
ulimit -c 0   

<?xml version='1.0'?>

<trace enabled="yes"
 home="/apps/BSCTOOLS/extrae/latest/impi_2017_4/bin"
 initial-mode="detail"
 type="paraver"
 xml-parser-id="Id: xml-parse.c 3269 2015-04-23 15:12:21Z harald $"
>

  <mpi enabled="yes">
    <counters enabled="yes" />
  </mpi>

  <openmp enabled="no">
    <locks enabled="no" />
    <counters enabled="yes" />
  </openmp>

  <pthread enabled="no">
    <locks enabled="no" />
    <counters enabled="yes" />
  </pthread>

  <callers enabled="no">
    <mpi enabled="yes">1-3</mpi>
    <sampling enabled="yes">1-5</sampling>
    <dynamic-memory enabled="no">1-3</dynamic-memory>
  </callers>

  <counters enabled="yes">
    <cpu enabled="yes" starting-set-distribution="1">
      <set enabled="yes" domain="all" changeat-time="0">
        PAPI_TOT_INS,PAPI_TOT_CYC,PAPI_L3_TCM
      </set>
      <set enabled="no" domain="all" changeat-time="0">
        PAPI_TOT_INS,PAPI_TOT_CYC,PAPI_LD_INS,PAPI_SR_INS,PAPI_BR_UCN,PAPI_BR_CN,PAPI_VEC_SP,RESOURCE_STALLS
        <sampling enabled="no" period="1000000000">PAPI_TOT_CYC</sampling>
      </set>
    </cpu>
    <network enabled="no" />
    <resource-usage enabled="no" />
    <memory-usage enabled="no" />
  </counters>

  <sampling enabled="no" type="default" period="50m" variability="10m" />

  <dynamic-memory enabled="no">
    <alloc enabled="yes" threshold="32768" />
    <free  enabled="yes" />
  </dynamic-memory>

  <input-output enabled="no" />

  <buffer enabled="yes">
    <size enabled="yes">20000000</size>
    <circular enabled="no" />
  </buffer>

  <user-functions enabled="yes" list="./extrae_functions_for_xml.txt" exclude-automatic-functions="yes" >
    <counters enabled="no" />
  </user-functions>


  <merge enabled="yes" 
    synchronization="default"
    tree-fan-out="16"
    max-memory="512"
    joint-states="yes"
    keep-mpits="yes"
    sort-addresses="yes"
    overwrite="yes"
  />

</trace>

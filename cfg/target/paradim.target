#!/bin/bash
source ../cfg/target/param_bash.cfg

args=("$@")

if [[ $# -lt 2 ]]
then
  echo $0 "expects N of Cores  and paradim configurations as input"
  echo "abort"
  exit 1
fi

analysis_tools=${args[0]}
cores=${args[1]}
paradim_configurations=("${args[@]:2}")

dimemas_traces=( ${cores}*.prv )
for trace in ${dimemas_traces[@]}
do
   for cfg in ${paradim_configurations[@]}
   do
      ${analysis_tools}/paramedir ${trace} ${cfg}
      output_name=$(basename ${cfg/.cfg/} ) 
      new_name=${trace/.prv/}_${output_name} 
      mv ${output_name} ${new_name}
   done 
done


#!/bin/bash
source cfg/target/param_bash.cfg
folder=$1
# Copy everything from reference folder
cp --remove-destination compilation_workdir/${configuration_folder}/${configuration_name}_vanilla/EXP00/* ${folder}
# Copy xios server
cp --remove-destination bin/xios_server.exe ${folder}
# Change namelist parameters
cfg/replace_namelist_parameter ${folder}/namelist_cfg nn_itend ${test_steps}
cfg/replace_namelist_parameter ${folder}/namelist_cfg ln_icebergs .false.
cfg/replace_namelist_parameter ${folder}/namelist_ref ln_meshmask .false.
cfg/replace_namelist_parameter ${folder}/namelist_ref ln_timing   .true.
cfg/replace_namelist_parameter ${folder}/namelist_cfg ln_timing   .true.
# Disable output
if [ ${output} == FALSE ] ; then \
   sed -i "s/^.*file_definition.*$$//g" ${folder}/context_nemo.xml ; \
fi

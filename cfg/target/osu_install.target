#!/bin/bash
if [[ $# -lt 1 ]]
then
  echo $0": expects 1 args, "$#" given"
  echo "abort"
  exit 1
fi
osu_folder=$1

wget http://mvapich.cse.ohio-state.edu/download/mvapich/${osu_folder}.tar.gz

tar -xvf ${osu_folder}.tar.gz
rm ${osu_folder}.tar.gz
cd ${osu_folder} 
./configure CC=`which mpicxx` CXX=`which mpicc` --prefix=`pwd`
make install
make

#!/bin/bash
args=("$@")

if [[ $# -lt 3 ]]
then
  echo $0 "expects N of Cores  and paradim configurations as input"
  echo "abort"
  exit 1
fi

[ -z ${analysis_tools+x} ] && echo "Variable analysis_tools must be defined" && exit 1

trace=${args[0]}
image_folder=${args[1]}
paraver_configurations=("${args[@]:2}")

cd ${image_folder}
# Make paraver images
for cfg in ${paraver_configurations[@]} 
do 
  ${analysis_tools}/paraver -i ${trace} ${cfg} 
done

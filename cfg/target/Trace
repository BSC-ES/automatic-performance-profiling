#!/bin/bash
source cfg/target/param_bash.cfg
trace_folder=$1
# Copy everything from reference folder
cp --remove-destination compilation_workdir/${configuration_folder}/${configuration_name}_trace/EXP00/* ${trace_folder}
# Copy xios server
cp --remove-destination bin/xios_server.exe ${trace_folder}
# Fix namelist parameters
cfg/replace_namelist_parameter ${trace_folder}/namelist_cfg nn_itend ${trace_steps}
cfg/replace_namelist_parameter ${trace_folder}/namelist_cfg ln_icebergs .false.
cfg/replace_namelist_parameter ${trace_folder}/namelist_ref ln_meshmask .false.
# Set ice frequency to 1
cfg/replace_namelist_parameter ${trace_folder}/namelist_ref nn_fsbc 1
# Disable output
if [ ${output} == FALSE ] ; then \
   sed -i "s/^.*file_definition.*$$//g" ${trace_folder}/context_nemo.xml ; \
fi

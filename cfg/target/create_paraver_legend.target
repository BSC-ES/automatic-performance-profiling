#!/bin/bash
source cfg/target/param_bash.cfg
args=("$@")

if [[ $# -lt 3 ]]
then
  echo $0": expects 3 args, "$#" given"
  echo "abort"
  exit 1
fi

trace=${args[0]}
n_cores=${args[1]}
paraver_configurations=("${args[@]:2}")

image_folder=paraver_images/${n_cores}
for cfg in ${paraver_configurations[@]}
do
  cfg_name=${cfg##*/} 
  current_picture_name=${image_folder}/${cfg_name%.cfg}*@${model}.best_cut
  final_picture_name=${image_folder}/${cfg_name%.cfg}_trace_${n_cores}.png
  # This config didn't produce an image
  if ! ls ${current_picture_name}* 1> /dev/null 2>&1
  then
    continue
  fi

  # Is a picture with gradient
  if ls ${current_picture_name}.w_legend.png 1> /dev/null 2>&1
  then
    mv ${current_picture_name}.w_legend.png ${final_picture_name}
  # Is a graph with discrete legend
  elif ls ${current_picture_name}.code.png 1> /dev/null 2>&1
  then
    image_to_append=${current_picture_name}.code.png
    convert ${current_picture_name}.png ${image_to_append} -append ${final_picture_name}
  # Just rename the picture
  else
     mv ${current_picture_name}.png ${final_picture_name}
 fi
 # Remove the rest
 rm -f ${current_picture_name}.nn_gradient.png ${current_picture_name}.w_legend.png ${current_picture_name}.code.png ${current_picture_name}.png
done

#!/bin/bash
source ../cfg/target/param_bash.cfg

# Checks the arguments
if [[ ! $# -eq 1 ]]
then
  echo $0" : wrong number of input arguments"
  exit 1
fi

number_of_cores=$1

# Rename timing files and convert them to pkl format (needed by the workflow)
cp ${provided_traces_path}/${main_folder}/test_${number_of_cores}/ifs.stat ${number_of_cores}_test.ifs.stat
cp ${provided_traces_path}/${main_folder}/test_${number_of_cores}/Forecast.* ${number_of_cores}_test.Forecast
python3 ../cfg/parser/utils/model/${model}/convert_timing_files.py -t ${number_of_cores}_test.ifs.stat -f ${number_of_cores}_test.Forecast -o ${number_of_cores}_test.timing

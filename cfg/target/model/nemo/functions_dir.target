#!/bin/bash

args=("$@")

# Checks the arguments
if [[ ! $# -eq 1 ]]
then
  echo $0" : wrong number of input arguments"
  exit 1
fi
# Check if files exist
for arg in ${args[@]}
do
  if [[ ! -d ${arg} ]]
  then
    echo $0": File "${arg} " does not exist"
    exit 1
  fi
done

run_folder=${args[0]}

source cfg/target/param_bash.cfg

# Copy everything from reference folder
cp --remove-destination compilation_workdir/${configuration_folder}/${configuration_name}_trace/EXP00/* ${run_folder} 

# Copy xios server
cp --remove-destination bin/xios_server.exe ${run_folder}

# Fix namelist parameters
cfg/replace_namelist_parameter ${run_folder}/namelist_cfg nn_itend 400
cfg/replace_namelist_parameter ${run_folder}/namelist_cfg ln_icebergs .false.
cfg/replace_namelist_parameter ${run_folder}/namelist_ref ln_meshmask .false.

# Disable output
if [ ${output} == FALSE ] ; then \
   sed -i "s/^.*file_definition.*$$//g" ${run_folder}/context_nemo.xml ; \
fi


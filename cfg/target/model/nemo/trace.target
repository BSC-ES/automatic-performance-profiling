#!/bin/bash
# The job is submitted from the run folder
run_folder=`pwd`
cd ..
source cfg/target/param_bash.cfg

# Checks the arguments
if [[ ! $# -eq 1 ]]
then
  echo $0" : wrong number of input arguments"
  exit 1
fi

number_of_cores=$1

# Copy everything from reference folder
cp --remove-destination compilation_workdir/${configuration_folder}/${configuration_name}_trace/EXP00/* ${run_folder}
# Copy xios server
cp --remove-destination bin/xios_server.exe ${run_folder}
# Fix namelist parameters
cfg/replace_namelist_parameter ${run_folder}/namelist_cfg nn_itend ${trace_steps}
cfg/replace_namelist_parameter ${run_folder}/namelist_cfg ln_icebergs .false.
cfg/replace_namelist_parameter ${run_folder}/namelist_ref ln_meshmask .false.
# Set ice frequency to 1
cfg/replace_namelist_parameter ${run_folder}/namelist_ref nn_fsbc 1
# Disable output
if [ ${output} == FALSE ] ; then \
   sed -i "s/^.*file_definition.*$$//g" ${run_folder}/context_nemo.xml ; \
fi

# Run extrae
cd ${run_folder}

# Loadad EXTRAE module and create wrapper
module load gcc/8.1.0
module load EXTRAE/3.7.1

trace=trace.sh
cat << EOF > $trace
  #!/bin/bash

  export EXTRAE_CONFIG_FILE=./extrae.xml
  source \$EXTRAE_HOME/etc/extrae.sh

  export LD_PRELOAD=\${EXTRAE_HOME}/lib/libmpitracecf.so
  export LD_LIBRARY_PATH=\${EXTRAE_HOME}/lib/:\$LD_LIBRARY_PATH

  \$*
EOF

chmod +x ${trace}

set -xuve
nemo_bin=nemo

# Generate function list for xml
./generate_function_list.sh ${nemo_bin} extrae_functions.txt

# Spinup run
time mpirun -genv I_MPI_DEBUG=4 -n ${number_of_cores} ./${trace} ./${nemo_bin}

# Create list extrae_functions.txt
set +xuve
# Clean a little bit
rm -rf set-* *.nc

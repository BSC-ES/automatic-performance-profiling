#!/bin/bash
args=("$@")

if [[ $# -lt 2 ]]
then
  echo $0 "expects analysis_tools path, dimemas trace, and paradim configurations as input"
  echo "abort"
  exit 1
fi

[ -z ${analysis_tools+x} ] && echo "Variable analysis_tools must be defined" && exit 1

trace=${args[0]}
dimemas_configurations=("${args[@]:1}")

# Remove path and extension
trace_name=${trace##*/}
trace_name=${trace_name%.*}
for cfg in ${dimemas_configurations[@]} 
do
  # Remove the path and extension
  cfg_name=${cfg##*/}
  cfg_name=${cfg_name%.*}

  ${analysis_tools}/Dimemas -S 32k --dim ${trace} -p ${trace_name}_${cfg_name}.prv --config-file ${cfg}
done

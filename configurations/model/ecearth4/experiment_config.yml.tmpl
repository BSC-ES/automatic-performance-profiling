- base.context:
    scratch: "%COMMON_PATH_LOCATIONS.COMPILATION_ROOT%/%CURRENT_ARCH_NAME%"
    experiment:
      id: ECE4
      base_dir: "%COMMON_PATH_LOCATIONS.COMPILATION_ROOT%/%CURRENT_ARCH_NAME%"
      run_dir: "RUN_FOLDER"
      src_dir: "%COMMON_PATH_LOCATIONS.COMPILATION_ROOT%/%CURRENT_ARCH_NAME%/sources/"
      ini_dir: "%EXPERIMENT.INIDATA%"

      schedule:
        all: !rrule >
          DTSTART:%CURRENT_START_DATE%
          RRULE:FREQ=%CURRENT_FREQ%;UNTIL=%CURRENT_END_DATE%;INTERVAL=%CURRENT_INTERVAL_VAL%

      run_from_scratch: true

    model_config:
      components: %MODEL.COMPONENTS%

- base.context:
    job:
      launch:
        method: slurm-shell
        shell:
          script: run-srun-multiprog.sh
      resubmit: false
      oifs:
        ntasks: OIFS_PROCS
        omp_num_threads: OIFS_OMP_THREADS
      amipfr:
        ntasks: %CURRENT_AMIP_PROCS%
      nemo:
        ntasks: NEMO_PROCS
      xios:
        ntasks: %CURRENT_XIOS_PROCS%

      slurm:
        sbatch:
          opts:
            wait: ""
            threads-per-core: 1
            time: 01:00:00
            qos: QUEUE
            account: ACCOUNT

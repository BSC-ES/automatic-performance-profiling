#!/bin/bash
###############################################################
###############################################################
##
## This script template is no longer mantained
##
## It is kept here to be used as an example to implement new
## launchers with the slurm-shell method, but is not guaranteed
## to work.
##
## The only supported template is run-srun-multiprog.sh.j2
##
###############################################################
###############################################################

#  Run EC-Earth4 GCM coupled

set -ex

./generate_func_list.sh ./nemo.exe ./oifs.exe ./extrae_functions.txt

#  DR_HOOK controls the tracing facility in OpenIFS.
#  0 = off, 1 = on.
export DR_HOOK=0
export DR_HOOK_IGNORE_SIGNALS='-1'

#  Set number of OpenMP threads to use. Must be compiled
#  with openmp for this to have any effect.
{% if job.oifs.omp_num_threads -%}export OMP_NUM_THREADS={{job.oifs.omp_num_threads}}{% endif %}

#  Increase stacksize as default too small
{% if job.oifs.omp_stacksize -%}export OMP_STACKSIZE={{job.oifs.omp_stacksize}}{% endif %}

#  Set the GRIB_SAMPLES_PATH to your installation.
#  Make sure LD_LIBRARY_PATH contains the grib_api 'lib' directory.
export GRIB_SAMPLES_PATH={{build.deps.grib.samples_path}}

export OASIS_OMP_NUM_THREADS=12

# Stack and core size limits
ulimit -s unlimited
ulimit -c unlimited

# Set tetralith specific environment
export I_MPI_FABRICS=shm:tmi

# ddt --connect \
mpirun \
    -np {{job.xios.ntasks}} ./trace.sh ./xios_server.exe : \
    -np {{job.nemo.ntasks}} ./trace.sh ./nemo.exe : \
    -np 1 ./trace.sh ./runoff-mapper.exe : \
    -np {{job.oifs.ntasks}} ./trace.sh ./oifs.exe -e {{experiment.id}}
# Model name
model=nemo
# Binary name of the model
bin_name=nemo
# Branch to profile
model_branch=avoid_error_partition
# Configuration name
configuration_name=orca025
# Platform
platform=mn4
# If part 1 of the workflow is executed on an external cluster and traces and timing files are provided, only part 2 of the workflow will be executed (TRUE or FALSE)
provided_traces=FALSE
# Path to the traces and timing files in case they are generated on an external cluster
#provided_traces_path=
# the following parameter should be cfgs in case the configuration is based on ORCA or tests if it is based n the bench
configuration_folder=tests
# Details of the configuration which you would put after makemodel, excluding the arch file
configuration_details=-a BENCH
# For BENCH specifies the resolution at which it will run
configuration_resolution=orca025
# Suffix of the arch file used
arch_file_prefix=prod
# Enable or disable output (TRUE or FALSE)
output=FALSE
# Number of steps used in test (Adjust acording to cost)
test_steps=200
trace_steps=20
# Model executes an initial setup timestep with value 0? (TRUE or FALSE)
timestep_0=FALSE
# Processes used for the modelfactor
number_of_processes=768 1024
# Tail size, needed for postproc
tile_size=62x40 47x40
# This value will be passed to the slurm parameter --ntasks-per-node (default on MN4 is 48) to run part 1 of the workflow (if provided_traces=FALSE). Note that this variable is NOT necessary if provided_traces=TRUE.
processes_per_node=48
# Which parts of the recipe will be executed when we run make experiment
experiment_recipes = process_json
# Folder in which all the results will be stored
main_folder = MultiExperimentRuns/weakscaling/BENCH/${configuration_name}
